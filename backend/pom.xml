<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        无人值守共享娱乐空间管理系统（uspace）- 后端
        系统代号 uspace = Unattended Space

        Spring Boot 版本选用 3.5.16（3.x 线最新）而非 4.x，原因：
        1. 毕设期间中文资料丰富度远高于 4.x，排障更快
        2. MyBatis-Plus 等第三方库对 4.x 的适配仍处于追赶期
        3. 4.x 的 starter 已模块化改名（如 web -> webmvc），生态跟进不足
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.kaede</groupId>
    <artifactId>uspace</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>uspace</name>
    <description>无人值守共享娱乐空间管理系统 - 后端服务</description>

    <properties>
        <!-- Spring Boot 3.x 最低要求 JDK 17 -->
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- JWT 库。0.12.x 与旧版 0.11.x 的 API 差异较大，用法见 JwtService -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <!-- Web MVC + RESTful API：前后端分离架构下对外提供 HTTP 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：承载需求中「建立数据校验机制」的部分 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            权限管理（模块 2）：过滤器链 + BCrypt 密码编码器 + @PreAuthorize 方法级鉴权。
            注意 Spring Boot 3 已废弃 WebSecurityConfigurerAdapter，
            安全配置一律改用 SecurityFilterChain Bean（见 auth/SecurityConfig）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            JWT（模块 2 的认证凭据）。
            拆成三个 artifact：api 是编译期接口，impl 与 jackson 只在运行期需要，
            故后两个用 runtime scope —— 与官方推荐用法一致。
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- WebSocket：QQ 机器人模块通过 NapCat 反向 WebSocket 接入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!--
            数据访问：MyBatis-Plus
            注意 artifactId 带 spring-boot3 后缀 —— 这是 Spring Boot 3.x 专用的 starter。
            误用 mybatis-plus-boot-starter（Boot 2.x 用）会导致自动配置失效。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!--
            MyBatis-Plus 3.5.x 起把分页插件依赖的 JSqlParser 拆成了独立 artifact。
            不引它，PaginationInnerInterceptor 会在运行期抛 ClassNotFoundException。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 开发期热重载，仅本地生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- 测试：Spring Boot 3.x 用统一的 spring-boot-starter-test（4.x 才拆成多个） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok 仅编译期使用，不打进可执行 jar -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        显式声明注解处理器路径，只有 Lombok。
                        不写这段的话 JDK 21 会从类路径隐式发现处理器并给出弃用警告，
                        且未来 JDK 版本会直接报错。${lombok.version} 由 spring-boot-starter-parent 管理。
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        给测试进程注入 JWT 密钥。
                        JwtService 构造时会校验密钥（为空或不足 32 字节即拒绝启动，fail-fast），
                        所以不注入的话所有 @SpringBootTest 都会因密钥缺失而挂掉。

                        ⚠️ 这一条【只用于测试】。生产密钥仍通过环境变量 JWT_SECRET 注入，
                           与数据库凭据同一处理方式，不写进仓库。
                    -->
                    <environmentVariables>
                        <JWT_SECRET>uspace-test-secret-only-for-unit-tests-46bytes</JWT_SECRET>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
